---
import PageLayout from '../../layouts/PageLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import HashScroll from '../../components/HashScroll.astro';
import { getCollection } from 'astro:content';
import { sortPublishedByDate } from '../../lib/content';

const notes = sortPublishedByDate(await getCollection('notes'));
---

<PageLayout title="随笔" description="其他记录与思考">
  <header class="mb-10">
    <h1 class="font-serif text-4xl font-semibold">随笔</h1>
    <p class="mt-3 w-full whitespace-nowrap text-[--color-muted]">不适合归入「学习」或「项目」的其他内容。</p>
  </header>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      notes.map((note) => (
        <section id={note.id} class="scroll-mt-24">
          <ArticleCard
            title={note.data.title}
            description={note.data.description}
            date={note.data.date}
            href={`/notes/${note.id}`}
            tags={note.data.tags}
          />
        </section>
      ))
    }
  </div>
</PageLayout>

<HashScroll />
