---
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/content';

const projects = (await getCollection('projects'))
  .filter((p) => isPublished(p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title="项目" description="Vibe Coding 项目展示">
  <header class="mb-10">
    <h1 class="font-serif text-4xl font-semibold">项目</h1>
    <p class="mt-3 max-w-xl text-[--color-muted]">
      Demo、原型与 Git 仓库。每个项目都是独立探索或实习/赛事产出。
    </p>
  </header>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          date={project.data.date}
          href={`/projects/${project.id}`}
          status={project.data.status}
          tags={project.data.tags}
          techStack={project.data.techStack}
          featured={project.data.featured}
        />
      ))
    }
  </div>
</PageLayout>
