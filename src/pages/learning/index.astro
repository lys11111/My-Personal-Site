---
import PageLayout from '../../layouts/PageLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/content';

const articles = (await getCollection('learning'))
  .filter((a) => isPublished(a.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [...new Set(articles.map((a) => a.data.category))];
---

<PageLayout title="学习" description="跨学科学习笔记">
  <header class="mb-10">
    <h1 class="font-serif text-4xl font-semibold">学习</h1>
    <p class="mt-3 max-w-xl text-[--color-muted]">
      AI 产品、Prompt 工程、游戏机制、Launch 指标等方向的阅读与实践笔记。
    </p>
    {
      categories.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {categories.map((cat) => (
            <span class="rounded-full border border-[--color-border] px-3 py-1 text-xs text-[--color-muted]">
              {cat}
            </span>
          ))}
        </div>
      )
    }
  </header>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      articles.map((article) => (
        <ArticleCard
          title={article.data.title}
          description={article.data.description}
          date={article.data.date}
          href={`/learning/${article.id}`}
          tags={article.data.tags}
          category={article.data.category}
          featured={article.data.featured}
        />
      ))
    }
  </div>
</PageLayout>
