---
import PageLayout from '../layouts/PageLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../lib/content';

const allProjects = (await getCollection('projects'))
  .filter((p) => isPublished(p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allLearning = (await getCollection('learning'))
  .filter((l) => isPublished(l.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 4);
const recentLearning = allLearning.slice(0, 5);

const languageTags = [
  'H5',
  'HTML5',
  'JavaScript',
  'TypeScript',
  'Python',
  'React',
  'Next.js',
  'FastAPI',
  'Kotlin',
];

const capabilityTags = [
  'Prompt',
  'RAG',
  'Skills',
  'Agent',
  'AIGC',
  'Computer Vision',
  'Workflow',
  'LLM',
  'Vibe Coding',
];
---

<PageLayout title="首页" description="龙文广 — AI 产品经理 · 学习与项目展示">
  <section class="mb-16">
    <p class="mb-4 text-sm tracking-widest text-[--color-accent] uppercase">Portfolio & Learning</p>
    <h1 class="max-w-3xl font-serif text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
      分享我的学习与构建～
    </h1>
    <p class="mt-6 w-full whitespace-nowrap text-lg leading-relaxed text-[--color-muted]">
      记录关于 Vibe Coding 项目原型、学习笔记以及其他简历放不下的细节。
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="/projects"
        class="rounded-lg border border-[--color-border] px-5 py-2.5 text-sm text-[--color-text] hover:border-[--color-accent] hover:text-[--color-accent]"
      >
        浏览项目
      </a>
      <a
        href="/about"
        class="rounded-lg border border-[--color-border] px-5 py-2.5 text-sm text-[--color-text] hover:border-[--color-accent] hover:text-[--color-accent]"
      >
        关于我
      </a>
    </div>
  </section>

  <section class="mb-16">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="font-serif text-2xl font-medium">精选项目</h2>
      <a href="/projects" class="text-sm text-[--color-muted] hover:text-[--color-accent]">查看全部 →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            date={project.data.date}
            href={`/projects/${project.id}`}
            status={project.data.status}
            showCover={false}
            tags={project.data.tags}
            techStack={project.data.techStack}
            featured={project.data.featured}
          />
        ))
      }
    </div>
  </section>

  <section class="mb-16">
    <div class="mb-6 flex items-end justify-between">
      <h2 class="font-serif text-2xl font-medium">最近学习</h2>
      <a href="/learning" class="text-sm text-[--color-muted] hover:text-[--color-accent]">查看全部 →</a>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        recentLearning.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            date={article.data.date}
            href={`/learning/${article.id}`}
            tags={article.data.tags}
            category={article.data.category}
            featured={article.data.featured}
          />
        ))
      }
    </div>
  </section>

  <section class="mb-16">
    <p class="mb-4 text-sm tracking-widest text-[--color-accent] uppercase">Tech Stack & Practice</p>
    <h2 class="font-serif text-2xl font-medium sm:text-3xl">个人标签—现有技术栈实践</h2>
    <p class="mt-6 text-lg leading-relaxed text-[--color-muted]">
      {languageTags.join(' · ')}
    </p>
    <p class="mt-3 text-lg leading-relaxed text-[--color-muted]">
      {capabilityTags.join(' · ')}
    </p>
    <p class="mt-4 text-lg leading-relaxed text-[--color-muted]">
      涵盖 AI 海外产品、Prompt 工程、Skills、RAG、AI+互动游戏、计算机视觉等方向。持续学习拓展中。
    </p>
  </section>
</PageLayout>
