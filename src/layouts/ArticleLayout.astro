---
import PageLayout from './PageLayout.astro';
import Badge from '../components/Badge.astro';
import TagList from '../components/TagList.astro';
import { projectStatusLabels } from '../lib/badges';
import { formatDate } from '../lib/content';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  category?: string;
  status?: string;
  demoUrl?: string;
  repoUrl?: string;
  cover?: string;
  techStack?: string[];
}

const {
  title,
  description,
  date,
  tags = [],
  category,
  status,
  demoUrl,
  repoUrl,
  cover,
  techStack = [],
} = Astro.props;
---

<PageLayout title={title} description={description}>
  <article>
    <header class="mb-10 border-b border-[--color-border] pb-8">
      <div class="meta-row text-sm">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <div class="meta-badges">
          {category && <Badge variant="outline">{category}</Badge>}
          {status && (
            <Badge variant="status">{projectStatusLabels[status] ?? status}</Badge>
          )}
        </div>
      </div>
      <h1 class="font-serif text-4xl font-semibold tracking-tight text-[--color-text]">{title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-[--color-muted]">{description}</p>
      {
        cover && (
          <div class="not-prose mt-8 w-full overflow-hidden rounded-xl border border-[--color-border] bg-[--color-bg] p-4">
            <img
              src={cover}
              alt={`${title} 原型预览`}
              class="mx-auto max-h-[min(85vh,960px)] w-full object-contain"
              loading="eager"
            />
          </div>
        )
      }
      {(demoUrl || repoUrl) && (
        <div class="mt-6 flex flex-wrap gap-3">
          {demoUrl && (
            <a
              href={demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg bg-[--color-accent] px-4 py-2 text-sm font-medium text-[--color-bg] hover:bg-[--color-accent-dim]"
            >
              查看 Demo
            </a>
          )}
          {repoUrl && (
            <a
              href={repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-[--color-border] px-4 py-2 text-sm text-[--color-text] hover:border-[--color-accent] hover:text-[--color-accent]"
            >
              GitHub
            </a>
          )}
        </div>
      )}
      {techStack.length > 0 && (
        <div class="mt-6">
          <TagList tags={techStack} />
        </div>
      )}
      {tags.length > 0 && (
        <div class="mt-4">
          <TagList tags={tags} muted />
        </div>
      )}
    </header>
    <div class="prose-content">
      <slot />
    </div>
  </article>
</PageLayout>
