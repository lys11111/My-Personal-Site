---
interface Props {
  variant?: 'featured' | 'status' | 'outline' | 'muted';
}

const { variant = 'outline' } = Astro.props;

const variantClass: Record<NonNullable<Props['variant']>, string> = {
  featured: 'border border-[--color-accent]/50 text-[--color-accent] bg-transparent',
  status: 'border border-transparent bg-[--color-accent]/15 text-[--color-accent]',
  outline: 'border border-[--color-border] text-[--color-muted] bg-transparent',
  muted: 'border border-[--color-border] text-[--color-muted] bg-[--color-surface]',
};
---

<span class:list={['badge', variantClass[variant]]}>
  <slot />
</span>
