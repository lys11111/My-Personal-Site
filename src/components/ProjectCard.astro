---
import { formatDate } from '../lib/content';
import { projectStatusLabels } from '../lib/badges';
import Badge from './Badge.astro';
import TagList from './TagList.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  href: string;
  status: string;
  cover?: string;
  showCover?: boolean;
  tags?: string[];
  techStack?: string[];
  featured?: boolean;
}

const {
  title,
  description,
  date,
  href,
  status,
  cover,
  showCover = true,
  tags = [],
  techStack = [],
  featured = false,
} = Astro.props;

const displayCover = showCover && cover;
---

<a
  href={href}
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-[--color-border] bg-[--color-surface] transition-all hover:border-[--color-accent]/40 hover:bg-[--color-surface-hover]"
>
  {
    displayCover && (
      <div class="aspect-video overflow-hidden border-b border-[--color-border]">
        <img
          src={cover}
          alt=""
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          loading="lazy"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-5">
    <div class="meta-row">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <div class="meta-badges">
        {featured && <Badge variant="featured">精选</Badge>}
        <Badge variant="status">{projectStatusLabels[status] ?? status}</Badge>
      </div>
    </div>
    <h3 class="font-serif text-xl font-medium text-[--color-text] group-hover:text-[--color-accent]">
      {title}
    </h3>
    <p class="mt-2 line-clamp-3 flex-1 text-sm text-[--color-muted]">{description}</p>
    {(techStack.length > 0 || tags.length > 0) && (
      <div class="mt-4">
        <TagList tags={techStack.length > 0 ? techStack : tags} muted />
      </div>
    )}
  </div>
</a>
