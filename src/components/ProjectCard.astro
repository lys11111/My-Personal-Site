---
import { formatDate } from '../lib/content';
import TagList from './TagList.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  href: string;
  status: string;
  cover?: string;
  tags?: string[];
  techStack?: string[];
  featured?: boolean;
}

const statusLabels: Record<string, string> = {
  demo: 'Demo',
  prototype: '原型',
  archived: '归档',
};

const {
  title,
  description,
  date,
  href,
  status,
  cover,
  tags = [],
  techStack = [],
  featured = false,
} = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col overflow-hidden rounded-xl border border-[--color-border] bg-[--color-surface] transition-all hover:border-[--color-accent]/40 hover:bg-[--color-surface-hover]"
>
  {
    cover && (
      <div class="aspect-video overflow-hidden border-b border-[--color-border]">
        <img
          src={cover}
          alt=""
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          loading="lazy"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-5">
  <div class="mb-3 flex items-center justify-between gap-2 text-xs">
    <time class="text-[--color-muted]" datetime={date.toISOString()}>{formatDate(date)}</time>
    <div class="flex gap-2">
      {featured && <span class="text-[--color-accent]">精选</span>}
      <span class="rounded-full bg-[--color-accent]/15 px-2 py-0.5 text-[--color-accent]">
        {statusLabels[status] ?? status}
      </span>
    </div>
  </div>
  <h3 class="font-serif text-xl font-medium text-[--color-text] group-hover:text-[--color-accent]">
    {title}
  </h3>
  <p class="mt-2 line-clamp-3 flex-1 text-sm text-[--color-muted]">{description}</p>
  {(techStack.length > 0 || tags.length > 0) && (
    <div class="mt-4">
      <TagList tags={techStack.length > 0 ? techStack : tags} muted />
    </div>
  )}
  </div>
</a>
