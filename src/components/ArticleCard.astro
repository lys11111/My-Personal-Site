---
import { formatDate } from '../lib/content';
import Badge from './Badge.astro';
import TagList from './TagList.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  href: string;
  tags?: string[];
  category?: string;
  featured?: boolean;
}

const { title, description, date, href, tags = [], category, featured = false } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-xl border border-[--color-border] bg-[--color-surface] p-5 transition-all hover:border-[--color-accent]/40 hover:bg-[--color-surface-hover]"
>
  <div class="meta-row">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    <div class="meta-badges">
      {category && <Badge variant="outline">{category}</Badge>}
      {featured && <Badge variant="featured">精选</Badge>}
    </div>
  </div>
  <h3 class="font-serif text-lg font-medium text-[--color-text] group-hover:text-[--color-accent]">
    {title}
  </h3>
  <p class="mt-2 line-clamp-2 flex-1 text-sm text-[--color-muted]">{description}</p>
  {tags.length > 0 && (
    <div class="mt-4">
      <TagList tags={tags.slice(0, 4)} muted />
    </div>
  )}
</a>
