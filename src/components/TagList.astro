---
interface Props {
  tags: string[];
  muted?: boolean;
}

const { tags, muted = false } = Astro.props;
---

<div class="flex flex-wrap items-center gap-2">
  {
    tags.map((tag) => (
      <span class:list={['badge', muted ? 'border border-[--color-border] text-[--color-muted] bg-transparent' : 'border border-transparent bg-[--color-surface] text-[--color-accent]']}>
        {tag}
      </span>
    ))
  }
</div>
